<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:vm="using:Kometra.ViewModels.ImageProcessing"
        xmlns:models="using:Kometra.Models.Processing.Analysis"
        xmlns:vis="using:Kometra.ViewModels.Visualization"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Kometra.Views.EllipticalIsophoteToolView"
        x:DataType="vm:EllipticalIsophoteToolViewModel"
        Title="Isofote Topologiche"
        Width="1280" Height="800"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterOwner">

    <Window.DataTemplates>
        <DataTemplate x:DataType="vis:FitsRenderer" DataType="vis:FitsRenderer">
            <Border BorderBrush="#333333" BorderThickness="1" Background="Black" ClipToBounds="True">
                <Image Source="{Binding Image}" Stretch="Uniform" />
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <StyleInclude Source="/Styles/AlignmentToolStyles.axaml" />
    </Window.Styles>

    <Grid ColumnDefinitions="600, 4, *" RowDefinitions="*, Auto" Margin="12">
        
        <Grid Grid.Column="0" Grid.Row="0" RowDefinitions="Auto, Auto, *, Auto">
            
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="ISOFOTE" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0" />
                <TextBlock Text="Genera veri contorni topologici su fondo bianco. Cambia i parametri per aggiornare il grafico in tempo reale." 
                           FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, 10, *">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Minimo (ADU)" Classes="paramLabel"/>
                                <NumericUpDown Name="MinValueBox" Minimum="0" Maximum="1000000" Increment="10" FormatString="F1" 
                                               ValueChanged="OnBoxValueChanged" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Massimo (ADU)" Classes="paramLabel"/>
                                <NumericUpDown Name="MaxValueBox" Minimum="0" Maximum="1000000" Increment="10" FormatString="F1" 
                                               ValueChanged="OnBoxValueChanged" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, 10, *">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Passo (Step)" Classes="paramLabel"/>
                                <NumericUpDown Name="StepSizeBox" Minimum="1" Maximum="5000" Increment="10" FormatString="F0" 
                                               ValueChanged="OnBoxValueChanged" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,4">
                                <CheckBox Content="Monocromatico" IsChecked="{Binding IsMonochromatic}" Foreground="#E0E0E0" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1">
                <Grid>
                    <StackPanel IsVisible="{Binding !HasCalculatedProfile}" 
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <avalonia:MaterialIcon Kind="ImageOutline" Width="48" Height="48" Foreground="#444444"/>
                        <TextBlock Text="In attesa dell'anteprima..." 
                                   Foreground="#777777" FontSize="14" FontStyle="Italic" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TabControl SelectedIndex="{Binding SelectedTabIndex}" 
                                IsVisible="{Binding HasCalculatedProfile}"
                                Background="Transparent" BorderThickness="0" Padding="0">
                        <TabItem Header="Grafico">
                            <Border Margin="8" Background="White" BorderBrush="#333333" BorderThickness="1" ClipToBounds="True" CornerRadius="4">
                                <Image Source="{Binding OverlayImage}" Stretch="Uniform" />
                            </Border>
                        </TabItem>
                        <TabItem Header="Tabella">
                            <Grid RowDefinitions="Auto, *">
                                <Grid Grid.Row="0" ColumnDefinitions="*, *" Margin="8,8,8,8">
                                    <TextBlock Grid.Column="0" Text="Livello Isofota (ADU)" FontWeight="Bold" FontSize="12" Foreground="#AAAAAA"/>
                                    <TextBlock Grid.Column="1" Text="Area Racchiusa (px²)" FontWeight="Bold" FontSize="12" Foreground="#AAAAAA" HorizontalAlignment="Right"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Isophotes}" Margin="4,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:EllipticalIsophoteDataPoint" DataType="models:EllipticalIsophoteDataPoint">
                                                <Border BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="4,6">
                                                    <Grid ColumnDefinitions="*, *">
                                                        <TextBlock Grid.Column="0" Text="{Binding MeanValue, StringFormat={}{0:F2}}" FontSize="12" Foreground="#4CC2FF"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding PixelCount}" FontSize="12" Foreground="#E0E0E0" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="*, 10, *">
                <Button Grid.Column="0" Command="{Binding ExportDataCommand}" 
                        Content="{Binding ExportButtonText}" 
                        IsEnabled="{Binding HasCalculatedProfile}"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"/>
                        
                <Button Grid.Column="2" Content="Conferma Nodo" 
                        Command="{Binding ApplyCommand}" 
                        IsEnabled="{Binding HasCalculatedProfile}"
                        Classes="apply" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"/>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent" />

        <Grid Grid.Column="2" Grid.Row="0" Margin="8,0,0,0" RowDefinitions="*, Auto">
            
            <Border Grid.Row="0" Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid x:Name="ImageContainerGrid" Background="Transparent" ClipToBounds="True">
                    <ContentControl Content="{Binding PreviewRenderer}" />

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="10" 
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" ZIndex="1"
                                IsVisible="{Binding HasMultipleImages}">
                        <Button Command="{Binding Navigator.PreviousCommand}" ToolTip.Tip="Immagine precedente">
                            <avalonia:MaterialIcon Kind="ChevronLeft" Width="16" Height="16"/>
                        </Button>
                        <Border Background="#66000000" CornerRadius="4" Padding="8,0" VerticalAlignment="Stretch">
                            <TextBlock Text="{Binding CurrentImageText}" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>
                        <Button Command="{Binding Navigator.NextCommand}" ToolTip.Tip="Immagine successiva">
                            <avalonia:MaterialIcon Kind="ChevronRight" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>

                    <Border Background="#A0000000" IsVisible="{Binding IsLoading}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
                            <TextBlock Text="Elaborazione isofote in corso..." Foreground="White" FontSize="14" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="8,4" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>