<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:vm="using:Kometra.ViewModels.ImageProcessing"
        xmlns:models="using:Kometra.Models.Processing.Analysis"
        xmlns:vis="using:Kometra.ViewModels.Visualization"
        mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="700"
        x:Class="Kometra.Views.EllipticalIsophoteToolView"
        x:DataType="vm:EllipticalIsophoteToolViewModel"
        Title="Analisi e Modellizzazione Isofote Ellittiche"
        Width="1050" Height="700"
        MinWidth="850" MinHeight="550"
        WindowStartupLocation="CenterOwner">

    <Window.DataTemplates>
        <DataTemplate x:DataType="vis:FitsRenderer" DataType="vis:FitsRenderer">
            <Border BorderBrush="#333333" BorderThickness="1" Background="Black" ClipToBounds="True">
                <Image Source="{Binding Image}" Stretch="Uniform" />
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <StyleInclude Source="/Styles/AlignmentToolStyles.axaml" />

        <Style Selector="Button.calculate">
            <Setter Property="Background" Value="#8058E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.calculate:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#9470F0"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.calculate:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#444444"/>
            <Setter Property="Foreground" Value="#AAAAAA"/>
        </Style>

        <Style Selector="NumericUpDown:disabled">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>
        <Style Selector="NumericUpDown:disabled /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton">
            <Setter Property="Foreground" Value="#777777"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Background" Value="#2A2A2A"/>
        </Style>
        <Style Selector="NumericUpDown:disabled /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton /template/ PathIcon">
            <Setter Property="Foreground" Value="#777777"/>
        </Style>

        <Style Selector="DataValidationErrors">
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </ControlTemplate>
            </Setter>
            <Setter Property="ErrorTemplate" Value="{x:Null}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="420, 4, *" RowDefinitions="*, Auto" Margin="12">
        
        <!-- COLONNA SINISTRA -->
        <Grid Grid.Column="0" Grid.Row="0" RowDefinitions="Auto, *, Auto">
            
            <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                    <TextBlock Text="PARAMETRI ELLISSE" FontSize="14" FontWeight="Bold" Foreground="#E0E0E0"/>
                    <TextBlock Text="Clicca sull'immagine a destra per posizionare il centro." FontSize="11" Foreground="#888888" TextWrapping="Wrap"/>
                    
                    <StackPanel Spacing="10" IsEnabled="{Binding !IsPreviewActive}">
                        <Grid ColumnDefinitions="*, 8, *">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Centro X (px)" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,2"/>
                                <NumericUpDown Name="CenterXBox" Value="{Binding CenterX, Mode=TwoWay}" Minimum="0" Maximum="100000" Increment="0.5" FormatString="F1" LostFocus="OnManualInputCommit" KeyDown="OnInputKeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Centro Y (px)" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,2"/>
                                <NumericUpDown Name="CenterYBox" Value="{Binding CenterY, Mode=TwoWay}" Minimum="0" Maximum="100000" Increment="0.5" FormatString="F1" LostFocus="OnManualInputCommit" KeyDown="OnInputKeyDown"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, 8, *">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Raggio Max 'a'" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,2"/>
                                <NumericUpDown Name="MaxRadiusBox" Value="{Binding MaxRadius, Mode=TwoWay}" Minimum="10" Maximum="5000" Increment="10" FormatString="F0" LostFocus="OnManualInputCommit" KeyDown="OnInputKeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Step Campionamento" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,2"/>
                                <NumericUpDown Name="StepSizeBox" Value="{Binding StepSize, Mode=TwoWay}" Minimum="0.5" Maximum="50" Increment="1.0" FormatString="F1" LostFocus="OnManualInputCommit" KeyDown="OnInputKeyDown"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, 8, *">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ellitticità (ε)" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,2"/>
                                <NumericUpDown Name="EllipticityBox" Value="{Binding Ellipticity, Mode=TwoWay}" Minimum="0.00" Maximum="0.85" Increment="0.05" FormatString="F2" LostFocus="OnManualInputCommit" KeyDown="OnInputKeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Angolo PA (°)" FontSize="11" Foreground="#AAAAAA" Margin="0,0,0,2"/>
                                <NumericUpDown Name="PositionAngleBox" Value="{Binding PositionAngleDeg, Mode=TwoWay}" Minimum="-180.0" Maximum="180.0" Increment="5.0" FormatString="F1" LostFocus="OnManualInputCommit" KeyDown="OnInputKeyDown"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Button Command="{Binding GeneratePreviewNodeCommand}" 
                            Content="Calcola Anteprima" 
                            Classes="calculate"
                            IsVisible="{Binding !IsPreviewActive}"
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center"
                            Margin="0,4,0,0"/>

                    <Grid ColumnDefinitions="*, 10, *" IsVisible="{Binding IsPreviewActive}" Margin="0,4,0,0">
                        <Button Grid.Column="0" 
                                Content="Indietro" 
                                Command="{Binding RevertToOriginalCommand}" 
                                Classes="cancel"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>

                        <Button Grid.Column="2" 
                                Content="Applica" 
                                Command="{Binding ApplyCommand}" 
                                Classes="apply"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid RowDefinitions="Auto, *">
                    <Grid Grid.Row="0" ColumnDefinitions="2*, 2*, 2*, 3*, 3*" Margin="2,2,2,6">
                        <TextBlock Grid.Column="0" Text="Asse 'a'" FontWeight="Bold" FontSize="11" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Column="1" Text="ε" FontWeight="Bold" FontSize="11" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Column="2" Text="PA" FontWeight="Bold" FontSize="11" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Column="3" Text="Media" FontWeight="Bold" FontSize="11" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Column="4" Text="Dev.Std" FontWeight="Bold" FontSize="11" Foreground="#AAAAAA" HorizontalAlignment="Right"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Isophotes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:EllipticalIsophoteDataPoint" DataType="models:EllipticalIsophoteDataPoint">
                                    <Border BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="2,4">
                                        <Grid ColumnDefinitions="2*, 2*, 2*, 3*, 3*">
                                            <TextBlock Grid.Column="0" Text="{Binding SemiMajorAxis, StringFormat={}{0:F1}}" FontSize="11" Foreground="#E0E0E0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Ellipticity, StringFormat={}{0:F2}}" FontSize="11" Foreground="#BBBBBB"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PositionAngleRad, StringFormat={}{0:F1}}" FontSize="11" Foreground="#BBBBBB"/>
                                            <TextBlock Grid.Column="3" Text="{Binding MeanValue, StringFormat={}{0:F2}}" FontSize="11" Foreground="#4CC2FF"/>
                                            <TextBlock Grid.Column="4" Text="{Binding StandardDeviation, StringFormat={}{0:F2}}" FontSize="11" Foreground="#888888" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <Button Command="{Binding ExportCsvCommand}" 
                        Content="Esporta CSV..." 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"/>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"/>

        <!-- COLONNA DESTRA: IMMAGINE SOPRA, BARRA FRECCETTE SOTTO -->
        <Grid Grid.Column="2" Grid.Row="0" Margin="8,0,0,0" RowDefinitions="*, Auto">
            
            <Border Grid.Row="0" Background="#161616" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid x:Name="ImageContainerGrid" Background="Transparent" PointerPressed="OnViewportPointerPressed" ClipToBounds="True">
                    <ContentControl x:Name="ViewportControl" 
                                    Content="{Binding PreviewRenderer}" />

                    <Canvas x:Name="CrosshairOverlay" IsHitTestVisible="False" ClipToBounds="True" IsVisible="{Binding !IsPreviewActive}">
                        <Line x:Name="CrosshairLineH" Stroke="#FF3333" StrokeThickness="1.5" StrokeDashArray="4,2" IsVisible="False" />
                        <Line x:Name="CrosshairLineV" Stroke="#FF3333" StrokeThickness="1.5" StrokeDashArray="4,2" IsVisible="False" />
                        <Ellipse x:Name="CrosshairCircle" Width="14" Height="14" Stroke="#FF3333" StrokeThickness="1.5" Fill="Transparent" IsVisible="False" />
                    </Canvas>

                    <Border Background="#A0000000" IsVisible="{Binding IsLoading}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
                            <TextBlock Text="Elaborazione isofote in corso..." Foreground="White" FontSize="14" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- BARRA DI NAVIGAZIONE SOTTO L'IMMAGINE -->
            <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="0,1,0,0" 
                    Padding="10,8" IsVisible="{Binding HasMultipleImages}">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Command="{Binding Navigator.MoveToFirstCommand}" ToolTip.Tip="Prima immagine" Width="36" Height="34">
                        <avalonia:MaterialIcon Kind="ChevronDoubleLeft" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding Navigator.PreviousCommand}" ToolTip.Tip="Immagine precedente" Width="36" Height="34">
                        <avalonia:MaterialIcon Kind="ChevronLeft" Width="18" Height="18"/>
                    </Button>
                    <Border Background="#2A2A2A" BorderBrush="#444444" BorderThickness="1" CornerRadius="4" Padding="14,6" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentImageText}" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="12"/>
                    </Border>
                    <Button Command="{Binding Navigator.NextCommand}" ToolTip.Tip="Immagine successiva" Width="36" Height="34">
                        <avalonia:MaterialIcon Kind="ChevronRight" Width="18" Height="18"/>
                    </Button>
                    <Button Command="{Binding Navigator.MoveToLastCommand}" ToolTip.Tip="Ultima immagine" Width="36" Height="34">
                        <avalonia:MaterialIcon Kind="ChevronDoubleRight" Width="18" Height="18"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="8,4" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>