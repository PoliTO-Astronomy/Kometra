<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:vm="using:Kometra.ViewModels.ImageProcessing"
        xmlns:vis="using:Kometra.ViewModels.Visualization"
        xmlns:models="using:Kometra.Models.Processing.Analysis"
        xmlns:infrastructure="clr-namespace:Kometra.Infrastructure"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Kometra.Views.RadialProfileToolView"
        x:DataType="vm:RadialProfileToolViewModel"
        Title="{Binding [MenuRadialProfiles], Source={x:Static infrastructure:LocalizationManager.Instance}}"
        Width="1280" Height="800"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterOwner">

    <Window.DataTemplates>
        <DataTemplate x:DataType="vis:FitsRenderer" DataType="vis:FitsRenderer">
            <Border BorderBrush="#333333" BorderThickness="1" Background="Black" ClipToBounds="True">
                <Image Source="{Binding Image}" Stretch="Uniform" />
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <StyleInclude Source="/Styles/AlignmentToolStyles.axaml" />
    </Window.Styles>

    <Grid ColumnDefinitions="600, 4, *" RowDefinitions="*, Auto" Margin="12">
        
        <Grid Grid.Column="0" Grid.Row="0" RowDefinitions="Auto, Auto, *, Auto">
            
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{Binding [TitleRadialProfile], Source={x:Static infrastructure:LocalizationManager.Instance}}" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0" />
                <TextBlock Text="{Binding [DescRadialProfile], Source={x:Static infrastructure:LocalizationManager.Instance}}" 
                           FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*, 10, *">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding [ParamCenterX], Source={x:Static infrastructure:LocalizationManager.Instance}}" Classes="paramLabel"/>
                            <NumericUpDown Name="CenterXBox" Minimum="0" Maximum="100000" Increment="0.1" FormatString="F2" 
                                           ValueChanged="OnBoxValueChanged" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding [ParamCenterY], Source={x:Static infrastructure:LocalizationManager.Instance}}" Classes="paramLabel"/>
                            <NumericUpDown Name="CenterYBox" Minimum="0" Maximum="100000" Increment="0.1" FormatString="F2" 
                                           ValueChanged="OnBoxValueChanged" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*, 10, *">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding [ParamMaxRadius], Source={x:Static infrastructure:LocalizationManager.Instance}}" Classes="paramLabel"/>
                            <NumericUpDown Name="MaxRadiusBox" Minimum="5" Maximum="2000" Increment="5" FormatString="F0" 
                                           ValueChanged="OnBoxValueChanged" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding [ParamStepBin], Source={x:Static infrastructure:LocalizationManager.Instance}}" Classes="paramLabel"/>
                            <NumericUpDown Name="StepSizeBox" Minimum="0.5" Maximum="50" Increment="0.5" FormatString="F1" 
                                           ValueChanged="OnBoxValueChanged" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*, 10, *">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding [ParamStartAngle], Source={x:Static infrastructure:LocalizationManager.Instance}}" Classes="paramLabel"/>
                            <NumericUpDown Name="StartingAngleBox" Minimum="-360" Maximum="360" Increment="5" FormatString="F0" 
                                           ValueChanged="OnBoxValueChanged" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{Binding [ParamIntAngle], Source={x:Static infrastructure:LocalizationManager.Instance}}" Classes="paramLabel"/>
                            <NumericUpDown Name="IntegrationAngleBox" Minimum="1" Maximum="180" Increment="5" FormatString="F0" 
                                           ValueChanged="OnBoxValueChanged" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel>
                        <TextBlock Text="{Binding [ParamStatMetric], Source={x:Static infrastructure:LocalizationManager.Instance}}" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <ComboBox SelectedItem="{Binding SelectedMode}" HorizontalAlignment="Stretch">
                            <models:RadialProfileMode>Mean</models:RadialProfileMode>
                            <models:RadialProfileMode>Median</models:RadialProfileMode>
                            <models:RadialProfileMode>Sum</models:RadialProfileMode>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1">
                <Grid>
                    <TabControl SelectedIndex="{Binding SelectedTabIndex}" 
                                Background="Transparent" BorderThickness="0" Padding="0">
                        <TabItem Header="{Binding [TabGraph], Source={x:Static infrastructure:LocalizationManager.Instance}}">
                            <sp:AvaPlot Name="ProfilePlot" Margin="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </TabItem>
                        <TabItem Header="{Binding [TabTable], Source={x:Static infrastructure:LocalizationManager.Instance}}">
                            <Grid RowDefinitions="Auto, *">
                                <Grid Grid.Row="0" ColumnDefinitions="2*, 3*, 3*, 2*" Margin="8,8,8,8">
                                    <TextBlock Grid.Column="0" Text="{Binding [ColRadius], Source={x:Static infrastructure:LocalizationManager.Instance}}" FontWeight="Bold" FontSize="12" Foreground="#AAAAAA"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [ColValue], Source={x:Static infrastructure:LocalizationManager.Instance}}" FontWeight="Bold" FontSize="12" Foreground="#AAAAAA"/>
                                    <TextBlock Grid.Column="2" Text="{Binding [ColStdDev], Source={x:Static infrastructure:LocalizationManager.Instance}}" FontWeight="Bold" FontSize="12" Foreground="#AAAAAA"/>
                                    <TextBlock Grid.Column="3" Text="{Binding [ColPixelCount], Source={x:Static infrastructure:LocalizationManager.Instance}}" FontWeight="Bold" FontSize="12" Foreground="#AAAAAA" HorizontalAlignment="Right"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ProfilePoints}" Margin="4,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:RadialProfileDataPoint" DataType="models:RadialProfileDataPoint">
                                                <Border BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="4,6">
                                                    <Grid ColumnDefinitions="2*, 3*, 3*, 2*">
                                                        <TextBlock Grid.Column="0" Text="{Binding Radius, StringFormat={}{0:F1}}" FontSize="12" Foreground="#E0E0E0"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat={}{0:F2}}" FontSize="12" Foreground="#4CC2FF" FontWeight="SemiBold"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding StandardDeviation, StringFormat={}{0:F2}}" FontSize="12" Foreground="#BBBBBB"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding PixelCount}" FontSize="12" Foreground="#888888" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="*, 10, *">
                <Button Grid.Column="0" Command="{Binding ExportDataCommand}" 
                        Content="{Binding ExportButtonText}" 
                        IsEnabled="{Binding HasProfileData}"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"/>
                        
                <Button Grid.Column="2" Content="{Binding [BtnConfirmNode], Source={x:Static infrastructure:LocalizationManager.Instance}}" 
                        Command="{Binding ApplyCommand}" 
                        IsEnabled="{Binding HasProfileData}"
                        Classes="apply" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"/>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent" />

        <Grid Grid.Column="2" Grid.Row="0" Margin="8,0,0,0" RowDefinitions="*, Auto">
            
            <Border Grid.Row="0" Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid x:Name="ImageContainerGrid" Background="Transparent" PointerPressed="OnViewportPointerPressed" ClipToBounds="True">
                    <ContentControl x:Name="ViewportControl" Content="{Binding Viewport}" />

                    <Canvas x:Name="CrosshairOverlay" IsHitTestVisible="False" ClipToBounds="True">
                        <Path x:Name="SectorOverlay" Stroke="Yellow" StrokeThickness="1.5" Fill="#22FFFF00" IsVisible="False" />
                        <Line x:Name="CrosshairLineH" Stroke="#FF3333" StrokeThickness="1.5" StrokeDashArray="4,2" IsVisible="False" />
                        <Line x:Name="CrosshairLineV" Stroke="#FF3333" StrokeThickness="1.5" StrokeDashArray="4,2" IsVisible="False" />
                        <Ellipse x:Name="CrosshairCircle" Width="14" Height="14" Stroke="#FF3333" StrokeThickness="1.5" Fill="Transparent" IsVisible="False" />
                    </Canvas>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="10" 
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" ZIndex="1"
                                IsVisible="{Binding HasMultipleImages}">
                        <Button Command="{Binding Navigator.PreviousCommand}" ToolTip.Tip="{Binding [TooltipPrevImage], Source={x:Static infrastructure:LocalizationManager.Instance}}">
                            <avalonia:MaterialIcon Kind="ChevronLeft" Width="16" Height="16"/>
                        </Button>
                        <Border Background="#66000000" CornerRadius="4" Padding="8,0" VerticalAlignment="Stretch">
                            <TextBlock Text="{Binding CurrentImageText}" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>
                        <Button Command="{Binding Navigator.NextCommand}" ToolTip.Tip="{Binding [TooltipNextImage], Source={x:Static infrastructure:LocalizationManager.Instance}}">
                            <avalonia:MaterialIcon Kind="ChevronRight" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>

                    <Border Background="#A0000000" IsVisible="{Binding IsLoading}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
                            <TextBlock Text="{Binding [StatusAnalyzing], Source={x:Static infrastructure:LocalizationManager.Instance}}" Foreground="White" FontSize="14" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="8,4" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>