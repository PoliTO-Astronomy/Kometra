<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Kometra.ViewModels.ImageProcessing"
        xmlns:vis="using:Kometra.ViewModels.Visualization"
        xmlns:models="using:Kometra.Models.Processing.Analysis"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="Kometra.Views.RadialProfileToolView"
        x:DataType="vm:RadialProfileToolViewModel"
        Title="Analisi Profilo Radiale"
        Width="1100" Height="700"
        MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner">

    <Window.DataTemplates>
        <!-- DataTemplate per il Viewport dell'immagine FITS (aggiunto x:DataType per i Compiled Bindings) -->
        <DataTemplate x:DataType="vis:FitsRenderer" DataType="vis:FitsRenderer">
        <Border BorderBrush="#333333" BorderThickness="1" Background="Black" ClipToBounds="True">
            <Image Source="{Binding Image}" Stretch="Uniform" />
        </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Grid ColumnDefinitions="420, 4, *" RowDefinitions="*, Auto" Margin="12">
        
        <!-- ========================================== -->
        <!-- COLONNA SINISTRA: PARAMETRI E TABELLA DATI -->
        <!-- ========================================== -->
        <Grid Grid.Column="0" Grid.Row="0" RowDefinitions="Auto, Auto, *, Auto">
            
            <!-- Intestazione -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="PROFILO RADIALE (LIGHT CURVE)" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0" />
                <TextBlock Text="Clicca sull'immagine a destra per posizionare il centro di analisi." 
                           FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Box Parametri di Input -->
            <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                    
                    <!-- Coordinate Centro X / Y -->
                    <Grid ColumnDefinitions="*, 10, *">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Centro X (px)" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                            <NumericUpDown Value="{Binding CenterX}" Minimum="0" Maximum="100000" Increment="0.5" FormatString="F1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Centro Y (px)" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                            <NumericUpDown Value="{Binding CenterY}" Minimum="0" Maximum="100000" Increment="0.5" FormatString="F1"/>
                        </StackPanel>
                    </Grid>

                    <!-- Raggio Massimo e Step Size -->
                    <Grid ColumnDefinitions="*, 10, *">
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Raggio Max (px)" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                            <NumericUpDown Value="{Binding MaxRadius}" Minimum="5" Maximum="2000" Increment="5" FormatString="F0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Step / Bin (px)" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                            <NumericUpDown Value="{Binding StepSize}" Minimum="0.5" Maximum="50" Increment="0.5" FormatString="F1"/>
                        </StackPanel>
                    </Grid>

                    <!-- Modalità Statistica -->
                    <StackPanel>
                        <TextBlock Text="Metrica Statistica per Anello" FontSize="12" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                        <ComboBox SelectedItem="{Binding SelectedMode}" HorizontalAlignment="Stretch">
                            <models:RadialProfileMode>Mean</models:RadialProfileMode>
                            <models:RadialProfileMode>Median</models:RadialProfileMode>
                            <models:RadialProfileMode>Sum</models:RadialProfileMode>
                        </ComboBox>
                    </StackPanel>

                    <!-- Pulsanti di Ricalcolo e Ripristino -->
                    <Button Command="{Binding CalculateProfileCommand}" 
                            Content="Ricalcola Profilo" 
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center"
                            Margin="0,4,0,0"/>

                    <Button Command="{Binding ResetPreviewCommand}" 
                            Content="Torna all'Immagine Originale" 
                            HorizontalAlignment="Stretch" 
                            HorizontalContentAlignment="Center"
                            IsVisible="{Binding HasPreview}"/>
                </StackPanel>
            </Border>

            <!-- Tabella Risultati (Elenco Anelli Radiali) -->
            <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="8">
                <Grid RowDefinitions="Auto, *">
                    <!-- Intestazione Tabella -->
                    <Grid Grid.Row="0" ColumnDefinitions="2*, 3*, 3*, 2*" Margin="4,4,4,8">
                        <TextBlock Grid.Column="0" Text="Raggio" FontWeight="Bold" FontSize="12" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Column="1" Text="Valore (ADU)" FontWeight="Bold" FontSize="12" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Column="2" Text="Dev. Std (σ)" FontWeight="Bold" FontSize="12" Foreground="#AAAAAA"/>
                        <TextBlock Grid.Column="3" Text="Pixel #" FontWeight="Bold" FontSize="12" Foreground="#AAAAAA" HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Elenco Punti -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ProfilePoints}">
                            <ItemsControl.ItemTemplate>
                                <!-- Aggiunto x:DataType="models:RadialProfileDataPoint" per i Compiled Bindings -->
                                <DataTemplate x:DataType="models:RadialProfileDataPoint" DataType="models:RadialProfileDataPoint">
                                    <Border BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="4,6">
                                        <Grid ColumnDefinitions="2*, 3*, 3*, 2*">
                                            <TextBlock Grid.Column="0" Text="{Binding Radius, StringFormat={}{0:F1}}" FontSize="12" Foreground="#E0E0E0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Value, StringFormat={}{0:F2}}" FontSize="12" Foreground="#4CC2FF" FontWeight="SemiBold"/>
                                            <TextBlock Grid.Column="2" Text="{Binding StandardDeviation, StringFormat={}{0:F2}}" FontSize="12" Foreground="#BBBBBB"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PixelCount}" FontSize="12" Foreground="#888888" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Pulsanti Esporta, Anteprima, Conferma e Chiudi -->
            <Grid Grid.Row="3" ColumnDefinitions="*, 6, *, 6, *, 6, Auto" Margin="0,12,0,0">
                <Button Grid.Column="0" 
                        Command="{Binding ExportCsvCommand}" 
                        Content="CSV..." 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"/>

                <Button Grid.Column="2" 
                        Command="{Binding GeneratePreviewCommand}" 
                        Content="Anteprima 2D" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"/>

                <Button Grid.Column="4" 
                        Command="{Binding ConfirmAndCreateNodeCommand}" 
                        Content="Genera Nodo" 
                        Classes="accent"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"/>
                        
                <Button Grid.Column="6" 
                        Command="{Binding CloseCommand}" 
                        Content="Chiudi" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"/>
            </Grid>
        </Grid>

        <!-- Separatore Resizable tra le due colonne -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent" />

        <!-- ========================================== -->
        <!-- COLONNA DESTRA: VIEWPORT IMMAGINE FITS     -->
        <!-- ========================================== -->
        <Grid Grid.Column="2" Grid.Row="0" Margin="8,0,0,0">
            <Border Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid x:Name="ImageContainerGrid">
                    <!-- 1. Renderizzatore dell'immagine FITS -->
                    <ContentControl x:Name="ViewportControl" 
                                    Content="{Binding Viewport}" 
                                    PointerPressed="OnViewportPointerPressed" />

                    <!-- 2. Overlay del Mirino (Crosshair del Centro) -->
                    <!-- IsHitTestVisible="False" permette ai clic di passare attraverso il mirino e raggiungere l'immagine -->
                    <Canvas x:Name="CrosshairOverlay" IsHitTestVisible="False" ClipToBounds="True">
                        <!-- Linea Orizzontale -->
                        <Line x:Name="CrosshairLineH"
                              Stroke="#FF3333" StrokeThickness="1.5"
                              StrokeDashArray="4,2"
                              IsVisible="False" />
                        <!-- Linea Verticale -->
                        <Line x:Name="CrosshairLineV"
                              Stroke="#FF3333" StrokeThickness="1.5"
                              StrokeDashArray="4,2"
                              IsVisible="False" />
                        <!-- Cerchietto Centrale -->
                        <Ellipse x:Name="CrosshairCircle"
                                 Width="14" Height="14"
                                 Stroke="#FF3333" StrokeThickness="1.5"
                                 Fill="Transparent"
                                 IsVisible="False" />
                    </Canvas>

                    <!-- 3. Overlay di Caricamento -->
                    <Border Background="#A0000000" IsVisible="{Binding IsLoading}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
                            <TextBlock Text="Elaborazione profilo in corso..." Foreground="White" FontSize="14" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- BARRA DI STATO IN BASSO -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="8,4" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>