<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
        xmlns:vm="using:Kometra.ViewModels.ImageProcessing"
        xmlns:vis="using:Kometra.ViewModels.Visualization"
        xmlns:models="using:Kometra.Models.Processing.Analysis"
        xmlns:infrastructure="clr-namespace:Kometra.Infrastructure"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="Kometra.Views.PhotometricProfileToolView"
        x:DataType="vm:PhotometricProfileToolViewModel"
        Title="{Binding [MenuPhotometricProfile], Source={x:Static infrastructure:LocalizationManager.Instance}}"
        Width="1280" Height="800"
        MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterOwner">

    <Window.DataTemplates>
        <DataTemplate x:DataType="vis:FitsRenderer" DataType="vis:FitsRenderer">
            <Border BorderBrush="#333333" BorderThickness="1" Background="Black" ClipToBounds="True">
                <Image Source="{Binding Image}" Stretch="Uniform" />
            </Border>
        </DataTemplate>
    </Window.DataTemplates>

    <Window.Styles>
        <StyleInclude Source="/Styles/AlignmentToolStyles.axaml" />
    </Window.Styles>

    <Grid ColumnDefinitions="600, 4, *" RowDefinitions="*, Auto" Margin="12">
        
        <Grid Grid.Column="0" Grid.Row="0" RowDefinitions="Auto, Auto, *, Auto">
            
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="{Binding [TitlePhotometric], Source={x:Static infrastructure:LocalizationManager.Instance}}" FontSize="16" FontWeight="Bold" Foreground="#E0E0E0" />
                <TextBlock Text="{Binding [DescPhotometric], Source={x:Static infrastructure:LocalizationManager.Instance}}" 
                           FontSize="12" Foreground="#888888" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*, 10, *">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [ParamStartX], Source={x:Static infrastructure:LocalizationManager.Instance}}" Classes="paramLabel"/>
                                <NumericUpDown Name="StartXBox" Minimum="0" Maximum="100000" Increment="1" FormatString="F0" 
                                               ValueChanged="OnBoxValueChanged" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [ParamStartY], Source={x:Static infrastructure:LocalizationManager.Instance}}" Classes="paramLabel"/>
                                <NumericUpDown Name="StartYBox" Minimum="0" Maximum="100000" Increment="1" FormatString="F0" 
                                               ValueChanged="OnBoxValueChanged" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown"/>
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="*, 10, *">
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding [ParamEndX], Source={x:Static infrastructure:LocalizationManager.Instance}}" Classes="paramLabel"/>
                                <NumericUpDown Name="EndXBox" Minimum="0" Maximum="100000" Increment="1" FormatString="F0" 
                                               ValueChanged="OnBoxValueChanged" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding [ParamEndY], Source={x:Static infrastructure:LocalizationManager.Instance}}" Classes="paramLabel"/>
                                <NumericUpDown Name="EndYBox" Minimum="0" Maximum="100000" Increment="1" FormatString="F0" 
                                               ValueChanged="OnBoxValueChanged" LostFocus="OnInputLostFocus" KeyDown="OnInputKeyDown"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border Background="#161616" BorderBrush="#333333" BorderThickness="1" CornerRadius="4" Padding="10">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding InfoDistance}" Foreground="#4CC2FF" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="{Binding InfoPeak}" Foreground="White" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1">
                <Grid>
                    <TabControl SelectedIndex="{Binding SelectedTabIndex}" 
                                Background="Transparent" BorderThickness="0" Padding="0">
                        <TabItem Header="{Binding [TabGraph], Source={x:Static infrastructure:LocalizationManager.Instance}}">
                            <sp:AvaPlot Name="ProfilePlot" Margin="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </TabItem>
                        <TabItem Header="{Binding [TabTable], Source={x:Static infrastructure:LocalizationManager.Instance}}">
                            <Grid RowDefinitions="Auto, *">
                                <Grid Grid.Row="0" ColumnDefinitions="*, *, *" Margin="8,8,8,8">
                                    <TextBlock Grid.Column="0" Text="Pixel" FontWeight="Bold" FontSize="12" Foreground="#AAAAAA"/>
                                    <TextBlock Grid.Column="1" Text="{Binding [ColDistance], Source={x:Static infrastructure:LocalizationManager.Instance}}" FontWeight="Bold" FontSize="12" Foreground="#AAAAAA" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding [ColIntensity], Source={x:Static infrastructure:LocalizationManager.Instance}}" FontWeight="Bold" FontSize="12" Foreground="#AAAAAA" HorizontalAlignment="Right"/>
                                </Grid>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ProfileData}" Margin="4,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:PhotometricDataPoint" DataType="models:PhotometricDataPoint">
                                                <Border BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="4,6">
                                                    <Grid ColumnDefinitions="*, *, *">
                                                        <TextBlock Grid.Column="0" Text="{Binding CoordinateText}" FontSize="12" Foreground="#888888"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Distance, StringFormat={}{0:F1}}" FontSize="12" Foreground="#E0E0E0" HorizontalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Value, StringFormat={}{0:F1}}" FontSize="12" Foreground="#4CC2FF" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="*, 10, *">
                <Button Grid.Column="0" Command="{Binding ExportDataCommand}" 
                        Content="{Binding ExportButtonText}" 
                        IsEnabled="{Binding HasCalculatedProfile}"
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"/>
                        
                <Button Grid.Column="2" Content="{Binding [BtnConfirmNode], Source={x:Static infrastructure:LocalizationManager.Instance}}" 
                        Command="{Binding ApplyCommand}" 
                        IsEnabled="{Binding HasCalculatedProfile}"
                        Classes="apply" 
                        HorizontalAlignment="Stretch" 
                        HorizontalContentAlignment="Center"/>
            </Grid>
        </Grid>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent" />

        <Grid Grid.Column="2" Grid.Row="0" Margin="8,0,0,0" RowDefinitions="*, Auto">
            
            <Border Grid.Row="0" Background="#141414" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <Grid x:Name="ImageContainerGrid" Background="Transparent" 
                      PointerPressed="OnViewportPointerPressed" 
                      PointerMoved="OnViewportPointerMoved"
                      PointerReleased="OnViewportPointerReleased"
                      ClipToBounds="True">
                    
                    <ContentControl x:Name="ViewportControl" Content="{Binding Viewport}" />

                    <Canvas x:Name="CrosshairOverlay" IsHitTestVisible="False" ClipToBounds="True">
                        <Line x:Name="CutLineOverlay" Stroke="#FF3333" StrokeThickness="2" IsVisible="False" />
                    </Canvas>

                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="10" 
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" ZIndex="1"
                                IsVisible="{Binding HasMultipleFiles}">
                        <Button Command="{Binding PreviousImageCommand}" ToolTip.Tip="{Binding [TooltipPrevImage], Source={x:Static infrastructure:LocalizationManager.Instance}}">
                            <avalonia:MaterialIcon Kind="ChevronLeft" Width="16" Height="16"/>
                        </Button>
                        <Border Background="#66000000" CornerRadius="4" Padding="8,0" VerticalAlignment="Stretch">
                            <TextBlock Text="{Binding CurrentImageText}" VerticalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="12"/>
                        </Border>
                        <Button Command="{Binding NextImageCommand}" ToolTip.Tip="{Binding [TooltipNextImage], Source={x:Static infrastructure:LocalizationManager.Instance}}">
                            <avalonia:MaterialIcon Kind="ChevronRight" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>

                    <Border Background="#A0000000" IsVisible="{Binding IsLoading}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
                            <TextBlock Text="{Binding [StatusAnalyzing], Source={x:Static infrastructure:LocalizationManager.Instance}}" Foreground="White" FontSize="14" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="8,4" Margin="0,8,0,0">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#AAAAAA" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>